# =============================================================================
# Hamro Pasal: environment variables
# Copy to `.env` at the repo root. apps/api and apps/worker load it automatically
# in `dev`/`start` and validate it at boot (packages/shared-types serverEnvSchema).
# Empty values are treated as unset, and a missing required value stops the process at boot.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development                 # development | test | production
LOG_LEVEL=info                       # error | warn | info | http | debug
COUNTRY_CODE=NP                      # Tenant partition. Only 'NP' is accepted.
API_PORT=4000

# --- Local end-to-end runs ------------------------------------------------------
# true: no third-party service is called. SMS and IVR are logged ("[sms:mock] …", "[ivr:mock] …")
# whatever SMS_PROVIDER / IVR_PROVIDER say, the worker logs "[MOCK PUSH] -> Vendor/User <id>: …"
# instead of calling Expo, and the API serves POST /api/test/mock-payment {order_id}.
# Refused at boot with NODE_ENV=production.
MOCK_SERVICES=false

# --- PostgreSQL 16+ ------------------------------------------------------------
# Used by docker-compose (pnpm infra:up) to provision the local database container.
# POSTGRES_PASSWORD is required and must match the password inside DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hamro_pasal
POSTGRES_PASSWORD=
POSTGRES_DB=hamro_pasal
# Used by the application. Must be postgres:// or postgresql://
DATABASE_URL=postgresql://hamro_pasal:CHANGE_ME@localhost:5432/hamro_pasal

# --- PostGIS -------------------------------------------------------------------
# Spatial reference ID for stored geometry (WGS 84 lat/lng).
POSTGIS_SRID=4326

# --- Redis (inventory locks, rate limiting, BullMQ) -----------------------------
# redis:// or rediss:// (TLS).
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379                      # Host port published by docker-compose

# --- Kafka -------------------------------------------------------------------
KAFKA_BROKERS=127.0.0.1:9092         # Comma-separated host:port list (127.0.0.1, not localhost: see docker-compose.yml)
KAFKA_CLIENT_ID=hamro-pasal
KAFKA_CONSUMER_GROUP_ID=hamro-pasal-worker
KAFKA_SSL=false                      # true | false
# Optional SASL auth. If a mechanism is set, username and password are required.
KAFKA_SASL_MECHANISM=                # plain | scram-sha-256 | scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_PORT=9092                      # Host port published by docker-compose

# --- Prometheus (local) ------------------------------------------------------
PROMETHEUS_PORT=9090                 # Host port for the Prometheus UI

# --- JWT -------------------------------------------------------------------------
# Access token TTL is 15 min and refresh token TTL is 7 days (fixed by SPEC.md).
# Each secret must be >= 32 chars, and the two must differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- eSewa ePay v2 ---------------------------------------------------------------
# Signature = Base64(HMAC-SHA256("total_amount,transaction_uuid,product_code", ESEWA_SECRET_KEY))
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_CHECK_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Redirect targets inside the app's WebView. The app intercepts success_url and forwards eSewa's
# base64 `data` query param to POST /api/payments/esewa/webhook (verified by HMAC signature).
ESEWA_SUCCESS_URL=http://localhost:4000/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:4000/payments/esewa/failure

# --- Khalti ePay v2 (Web Checkout) ---------------------------------------------
# Sent as header `Authorization: Key <KHALTI_SECRET_KEY>`
KHALTI_SECRET_KEY=
# Production per SPEC. Khalti's sandbox is https://dev.khalti.com/api/v2 (use its test keys).
KHALTI_BASE_URL=https://a.khalti.com/api/v2
# The app intercepts return_url and posts the pidx to POST /api/payments/khalti/lookup.
KHALTI_RETURN_URL=http://localhost:4000/payments/khalti/return
KHALTI_WEBSITE_URL=http://localhost:4000

# --- SMS / OTP (all recipients are +977) --------------------------------------
# Used by the API (login codes) and the worker (vendor suspension / restore / 90 s escalation SMS).
SMS_PROVIDER=SPARROW                 # SPARROW | AAKASH | MOCK (dev only: prints each SMS to the API/worker log). FIREBASE cannot send server-written SMS
WALLET_TOP_UP_MODE=DISABLED          # DISABLED | MOCK (dev only: vendor top-ups credit the wallet without any payment)
# Browser origins other than the API's own that may call it: exact origins, comma-separated, never a
# wildcard, https only in production. Leave empty when the admin dashboard is served from the API's origin.
CORS_ALLOWED_ORIGINS=
IVR_PROVIDER=DISABLED                # DISABLED | MOCK (dev only: the worker logs "[ivr:mock] Calling +977…" instead of phoning a vendor about a 90 s escalation)
# Expo push notifications (worker -> https://exp.host/--/api/v2/push/send). Leave empty unless the
# Expo project enforces "enhanced push security". With SMS_PROVIDER=MOCK the worker also logs the
# SMS each order push stands in for ("[sms:mock] to +977…: Hamro Pasal: New order. …").
EXPO_ACCESS_TOKEN=
# Only the selected provider's credentials are required.
# Sparrow SMS
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=
SPARROW_SMS_API_URL=https://api.sparrowsms.com/v2/sms/
# Aakash SMS
AAKASH_SMS_AUTH_TOKEN=
AAKASH_SMS_API_URL=https://sms.aakashsms.com/sms/v3/send
# Firebase Auth (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- File storage: dispute evidence, product photos, promotion images, KYC documents ---
# LOCAL (development and tests; refused in production): files on the API host's disk.
# S3: any S3-compatible bucket (Cloudflare R2, AWS S3).
STORAGE_DRIVER=LOCAL
# LOCAL: public files are saved under UPLOADS_DIR (default: apps/api/uploads, git-ignored) and
# served by the API at /uploads. A phone cannot load http://localhost: set the host's LAN IP.
UPLOADS_DIR=
UPLOADS_PUBLIC_BASE_URL=             # default http://localhost:<API_PORT>/uploads
UPLOADS_PRIVATE_DIR=                 # KYC documents; default apps/api/uploads-private (never served)
# S3: two buckets. The public one is read through S3_PUBLIC_BASE_URL (CDN / r2.dev / custom
# domain). The private one (KYC documents) must have NO public access: it is read through the API.
S3_ENDPOINT=                         # R2: https://<account-id>.r2.cloudflarestorage.com ; empty for AWS
S3_REGION=auto                       # R2: auto ; AWS: e.g. ap-south-1
S3_ACCESS_KEY_ID=                    # leave both empty to use an instance / task role (AWS)
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BASE_URL=                  # e.g. https://cdn.hamropasal.np
S3_FORCE_PATH_STYLE=false            # true for MinIO

# --- Mobile (apps/mobile) --------------------------------------------------------
# Expo reads EXPO_PUBLIC_* from apps/mobile/.env, not from this file.
# These values are bundled into the app binary, so never put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:4000
