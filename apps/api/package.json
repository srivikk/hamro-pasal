{
  "name": "@hamro-pasal/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hamro Pasal REST + WebSocket API (Express).",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/server.js",
    "token:dev": "tsx --env-file-if-exists=../../.env scripts/mint-dev-token.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@hamro-pasal/db": "workspace:*",
    "@hamro-pasal/shared-types": "workspace:*",
    "@hamro-pasal/sms": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/express": "^5.0.6",
    "@types/ioredis-mock": "^8.2.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/supertest": "^7.2.1",
    "ioredis-mock": "^8.13.1",
    "jest": "~29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15"
  }
}
