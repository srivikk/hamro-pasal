{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.18.1",
      "pnpm": "12.6.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "customer"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "customer"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "customer"
      }
    },
    "seller-development": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "seller"
      }
    },
    "seller-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "seller"
      }
    },
    "seller-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "seller"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "seller-production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
