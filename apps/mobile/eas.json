{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "customer"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "customer"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "customer"
      }
    },
    "seller-development": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "seller"
      }
    },
    "seller-preview": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "seller"
      }
    },
    "seller-production": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "seller"
      }
    }
  },
  "submit": {
    "production": {},
    "seller-production": {}
  }
}
