{
  "name": "@hamro-pasal/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Hamro Pasal background worker: Kafka event consumers and BullMQ scheduled/delayed jobs.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@hamro-pasal/shared-types": "workspace:*",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "~29.7.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15"
  }
}
