{
  "name": "@hamro-pasal/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Hamro Pasal background worker: outbox relay to Kafka, Kafka consumers, BullMQ delayed jobs and crons.",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@hamro-pasal/db": "workspace:*",
    "@hamro-pasal/kafka": "workspace:*",
    "@hamro-pasal/shared-types": "workspace:*",
    "@socket.io/redis-emitter": "^5.1.0",
    "bullmq": "^6.3.9",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/jest": "^29.5.14",
    "jest": "~29.7.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15"
  }
}
