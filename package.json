{
  "name": "hamro-pasal",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:all": "turbo run dev --concurrency=20",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean",
    "infra:up": "docker compose up --detach --wait && docker compose run --rm kafka-init && docker compose run --rm kafka-test-init",
    "infra:down": "docker compose down --remove-orphans",
    "dev:reset": "node infra/dev-reset.mjs",
    "infra:reset": "docker compose --profile init down --volumes --remove-orphans && pnpm infra:up",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
